# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=llm_handoff
MYSQL_USER=llm_handoff
MYSQL_PASSWORD=llm_handoff

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_hs512_minimum_64_characters_long_string_here
JWT_EXPIRATION_MS=86400000

# OAuth2 & Redirect Configuration
OAUTH2_REDIRECT_URI=https://ai-handoff.online
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth2 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server Strategy
SERVER_FORWARD_HEADERS_STRATEGY=framework
