{
  "uid": "llm-handoff-backend-overview",
  "title": "Backend Overview",
  "tags": ["llm-handoff"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate (req/s)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{application=\"llm-handoff-backend\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 2,
      "title": "5xx error rate (req/s)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"llm-handoff-backend\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 3,
      "title": "HTTP latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"llm-handoff-backend\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"llm-handoff-backend\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"llm-handoff-backend\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 4,
      "title": "Latency p95 by endpoint",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"llm-handoff-backend\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 5,
      "title": "JVM heap used vs max",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"llm-handoff-backend\",area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"llm-handoff-backend\",area=\"heap\"})",
          "legendFormat": "max",
          "refId": "B"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{application=\"llm-handoff-backend\",area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "id": 6,
      "title": "JVM threads / GC pause",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"llm-handoff-backend\"}",
          "legendFormat": "live threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"llm-handoff-backend\"}",
          "legendFormat": "daemon threads",
          "refId": "B"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"llm-handoff-backend\"}[5m])",
          "legendFormat": "gc pause rate",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
    },
    {
      "id": 7,
      "title": "HikariCP connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"llm-handoff-backend\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"llm-handoff-backend\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"llm-handoff-backend\"}",
          "legendFormat": "pending",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max{application=\"llm-handoff-backend\"}",
          "legendFormat": "max",
          "refId": "D"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
    },
    {
      "id": 8,
      "title": "DB pool wait / usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"llm-handoff-backend\"}[5m])",
          "legendFormat": "acquire rate",
          "refId": "A"
        },
        {
          "expr": "rate(hikaricp_connections_timeout_total{application=\"llm-handoff-backend\"}[5m])",
          "legendFormat": "timeouts/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
    }
  ]
}
